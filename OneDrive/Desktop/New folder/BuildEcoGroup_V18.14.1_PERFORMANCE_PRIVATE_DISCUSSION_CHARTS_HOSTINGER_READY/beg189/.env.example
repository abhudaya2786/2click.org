# BuildEcoGroup V18.15 Production Authentication & Persistence Environment Template
# ----------------------------------------------------------------------------------
# SECURITY NOTICE: Server-only secrets MUST NEVER use the VITE_ prefix.
# Never put real passwords, private keys, or session secrets into source control.

# 1. PostgreSQL Database URL (Drizzle ORM) — REQUIRED for durable registration
DATABASE_URL=postgresql://postgres:password@localhost:5432/buildecogroup
# Or discrete PG* variables:
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=

# 2. Server Runtime Configuration & Session
NODE_ENV=development
PORT=3000
SESSION_SECRET=your_super_secret_production_session_key_minimum_32_characters_long
APP_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
CORS_ORIGINS=https://www.buildecogroup.com,https://buildecogroup.com,http://localhost:3000

# 3. Firebase Admin SDK (Server-Side Token Verification)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full PEM including BEGIN/END lines. Prefer real newlines.
# If your host only accepts a single line, escape newlines as \n (without surrounding quotes).
FIREBASE_PRIVATE_KEY=

# 4. Super Admin bootstrap (temporary — remove after npm run bootstrap:superadmin)
SUPER_ADMIN_EMAIL=superadmin@buildecogroup.in
SUPER_ADMIN_TEMP_PASSWORD=
SUPER_ADMIN_RESET_PASSWORD=false

# 5. Optional Server AI Engine
GEMINI_API_KEY=

# 6. Public Firebase Client SDK (Safe for browser / Client-Side)
VITE_FIREBASE_API_KEY=
# Use the exact Firebase Web App authDomain, normally <project-id>.firebaseapp.com.
# Do not replace it with the public website URL.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_ENABLE_FIREBASE_PHONE_OTP=false

# 7. Public Client App Configuration
VITE_APP_NAME="BuildEcoGroup"
VITE_APP_ENV="development"
VITE_APP_VERSION="18.15.0"
VITE_API_BASE_URL="/api"
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# 8. Optional HubSpot CRM sync (server-only)
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PORTAL_ID=
