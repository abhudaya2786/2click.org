{
  "name": "buildecogroup-super-app",
  "private": true,
  "version": "18.15.0",
  "type": "module",
  "main": "dist/server.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --import tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:strict": "npm run verify:imports && npm run build",
    "build:hostinger": "npm run build",
    "start": "node server/start-hostinger.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx server/tests/runTests.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "node --import tsx server/scripts/runMigrations.ts",
    "bootstrap:superadmin": "node --import tsx server/scripts/bootstrapSuperAdmin.ts",
    "security:test": "node --import tsx server/tests/securityTests.ts",
    "auth:test": "node --import tsx server/tests/authFlowTests.ts",
    "persistence:test": "node --import tsx server/tests/persistenceTests.ts",
    "quotation:test": "node --import tsx server/tests/quotationTests.ts",
    "registration:test": "node --import tsx server/tests/registrationTests.ts",
    "role-privacy:test": "node --import tsx server/tests/rolePrivacyTests.ts",
    "consultant:test": "node --import tsx server/tests/consultantExperienceTests.ts",
    "session19:qa": "node --import tsx server/tests/session19ProductionQa.ts",
    "route-qa:test": "node --import tsx server/tests/routeQaTests.ts",
    "home-goal-cta:test": "node --import tsx server/tests/homeGoalCtaTests.ts",
    "guided-wizard:test": "node --import tsx server/tests/guidedWizardTests.ts",
    "service-evidence:test": "node --import tsx server/tests/serviceEvidenceCaptureTests.ts",
    "icon-system:test": "node --import tsx server/tests/iconSystemTests.ts",
    "buildEco-journey:test": "node --import tsx server/tests/buildEcoJourneyTests.ts",
    "buildEco-copilot:test": "node --import tsx server/tests/buildEcoCopilotTests.ts",
    "copilot-guide-security:test": "node --import tsx server/tests/copilotGuideSecurityTests.ts",
    "mobile-a11y-qa:test": "node --import tsx server/tests/mobileA11yQaTests.ts",
    "seo-performance:test": "node --import tsx server/tests/seoPerformanceTests.ts",
    "product-analytics:test": "node --import tsx server/tests/productAnalyticsTests.ts",
    "e2e-fresh-user:test": "node --import tsx server/tests/freshUserE2eRegression.ts",
    "rbac:test": "node --import tsx server/tests/rbacSuperAdminTests.ts",
    "verify:imports": "node --import tsx server/scripts/verifySourceImports.ts",
    "start:direct": "node dist/server.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.102.5",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "posthog-js": "^1.422.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.86.0",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
